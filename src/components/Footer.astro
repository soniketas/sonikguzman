	<div class="footer__bottom">
		<a href="mailto:sonia.guzman.19@gmail.com" class="footer__email">Email me →</a>
		<div class="footer__social">
			<a href="https://instagram.com/soni.k.guzman" target="_blank" rel="noopener">Instagram</a>
