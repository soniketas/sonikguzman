---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import { projects } from '../../data/projects';
import sharp from 'sharp';
import path from 'node:path';

export function getStaticPaths() {
	return projects.map((project, i) => ({
		params: { slug: project.slug },
		props: {
			project,
			next: projects[(i + 1) % projects.length],
			prev: projects[(i - 1 + projects.length) % projects.length],
		},
	}));
}

const { project, next, prev } = Astro.props;

// read real pixel dimensions from disk so <img> can carry width/height
// (avoids layout shift) without hand-maintaining them in projects.ts
const imageSrcs = [
	project.images?.cover.src,
	...(project.images?.process.map((p) => p.src) ?? []),
	...(project.extraSections?.flatMap((s) => s.images?.map((i) => i.src) ?? []) ?? []),
].filter((src): src is string => Boolean(src));

const dims = new Map(
	await Promise.all(
		imageSrcs.map(async (src) => {
			const { width, height } = await sharp(path.join(process.cwd(), 'public', src)).metadata();
			return [src, { width, height }] as const;
		})
	)
);
---

<Layout title={`${project.name} · Sonia`} description={project.summary}>
	<Nav back={{ href: '/#work', label: '← Back' }} />
	<main class="case" id="main-content">
		<header class="case__header">
			<span class="eyebrow">Case study</span>
			<h1 class="case__title">{project.name}</h1>
			<p class="case__summary">{project.summary}</p>

			<dl class="case__meta">
				<div>
					<dt>Client</dt>
					<dd>{project.client}</dd>
				</div>
				<div>
					<dt>Role</dt>
					<dd>{project.role}</dd>
				</div>
				<div>
					<dt>Year</dt>
					<dd>{project.year}</dd>
				</div>
				<div>
					<dt>Tools</dt>
					<dd>{project.tools}</dd>
				</div>
			</dl>
		</header>

		{
			project.images ? (
				<div class="case__cover case__cover--image" style={`background:${project.color}`}>
					<img
						src={project.images.cover.src}
						alt={project.images.cover.alt}
						width={dims.get(project.images.cover.src)?.width}
						height={dims.get(project.images.cover.src)?.height}
						decoding="async"
						fetchpriority="high"
					/>
				</div>
			) : (
				<div class="case__cover" style={`background:${project.color}`}>
					<span style={`color:${project.nameColor}`}>Project cover image</span>
				</div>
			)
		}

		<section class="case__section">
			<span class="eyebrow" style="--lime: var(--lime-text)">The challenge</span>
			<p class="case__lead">{project.challenge}</p>
		</section>

		<section class="case__section">
			<span class="eyebrow" style="--lime: var(--lime-text)">The process</span>
			<p class="case__body">{project.process}</p>
			<div class="case__gallery" style={project.images ? `--gallery-cols: ${project.images.process.length}` : undefined}>
				{
					project.images ? (
						project.images.process.map((image) => (
							<div
								class:list={[
									'case__placeholder',
									'case__placeholder--image',
									project.images?.processFit === 'contain' && 'case__placeholder--contain',
								]}
								style={`background:${project.color}`}
							>
								<img
									src={image.src}
									alt={image.alt}
									width={dims.get(image.src)?.width}
									height={dims.get(image.src)?.height}
									loading="lazy"
									decoding="async"
								/>
							</div>
						))
					) : (
						<>
							<div class="case__placeholder">Process image 1</div>
							<div class="case__placeholder">Process image 2</div>
						</>
					)
				}
			</div>
		</section>

		{
			project.extraSections?.map((section) => (
				<section class="case__section">
					<span class="eyebrow" style="--lime: var(--lime-text)">{section.title}</span>
					<p class="case__body">{section.description}</p>
					{section.video ? (
						<div class="case__video">
							<video
								src={section.video.src}
								aria-label={section.video.description}
								autoplay
								muted
								loop
								playsinline
							/>
							{section.video.controls && (
								<button type="button" class="case__video-toggle" data-state="playing" aria-label="Pause video">
									<span class="case__video-toggle-icon" aria-hidden="true" />
								</button>
							)}
						</div>
					) : (
						<div class="case__gallery case__gallery--wide">
							{section.images?.map((image) => (
								<div class="case__placeholder case__placeholder--wide-image" style={`background:${project.color}`}>
									<img
										src={image.src}
										alt={image.alt}
										width={dims.get(image.src)?.width}
										height={dims.get(image.src)?.height}
										loading="lazy"
										decoding="async"
									/>
								</div>
							))}
						</div>
					)}
				</section>
			))
		}

		<section class="case__section">
			<span class="eyebrow" style="--lime: var(--lime-text)">The result</span>
			<p class="case__lead">{project.result}</p>
			{!project.images && <div class="case__placeholder case__placeholder--wide">Final / result image</div>}
		</section>

		<footer class="case__footer">
			<a href={`/work/${prev.slug}`} class="case__nav-link case__nav-link--prev" aria-label={`Previous project: ${prev.name}`}>
				<span class="eyebrow" style="--lime: var(--lime-text)">← Previous</span>
				<span class="case__nav-name">{prev.name}</span>
			</a>
			<a href={`/work/${next.slug}`} class="case__nav-link case__nav-link--next" aria-label={`Next project: ${next.name}`}>
				<span class="eyebrow" style="--lime: var(--lime-text)">Next →</span>
				<span class="case__nav-name">{next.name}</span>
			</a>
		</footer>
	</main>
</Layout>

<style>
	.case {
		max-width: 1440px;
		margin: 0 auto;
		padding: 140px var(--margin) 100px;
	}

	.case__title {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: clamp(48px, 8vw, 84px);
		letter-spacing: -0.03em;
		margin: 16px 0 20px;
	}

	.case__summary {
		font-size: 19px;
		color: var(--gray);
		max-width: 620px;
		line-height: 1.45;
		margin: 0 0 56px;
	}

	.case__meta {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 24px;
		padding-bottom: 48px;
		border-bottom: 1px solid var(--border);
		margin: 0 0 64px;
	}

	.case__meta dt {
		font-size: 11.5px;
		font-weight: 500;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--gray);
		margin-bottom: 6px;
	}

	.case__meta dd {
		margin: 0;
		font-size: 15.5px;
		font-weight: 500;
	}

	.case__cover {
		height: 60vh;
		border-radius: 20px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 14px;
		font-weight: 500;
		margin-bottom: 96px;
	}

	.case__cover--image img {
		height: 88%;
		width: auto;
		object-fit: contain;
		border-radius: 20px;
	}

	.case__section {
		margin-bottom: 80px;
	}

	.case__lead {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: clamp(22px, 3vw, 28px);
		letter-spacing: -0.01em;
		line-height: 1.35;
		max-width: 760px;
		margin: 20px 0 0;
	}

	.case__body {
		font-size: 17px;
		color: var(--gray);
		line-height: 1.5;
		max-width: 700px;
		margin: 20px 0 0;
	}

	.case__gallery {
		display: grid;
		grid-template-columns: repeat(var(--gallery-cols, 2), 1fr);
		gap: 40px;
		margin-top: 32px;
	}

	.case__video {
		position: relative;
		margin-top: 32px;
		display: flex;
		justify-content: center;
		align-items: center;
		/* true black, matching the phone bezel/letterboxing baked into the
		   recordings themselves — var(--ink) is a dark gray and left a visible seam */
		background: #000;
		border-radius: 20px;
		padding: 32px;
		min-height: 380px;
	}

	.case__video video {
		max-height: 560px;
		max-width: 100%;
		width: auto;
		height: auto;
		border-radius: 12px;
	}

	/* minimal pause/play control for the autoplay-loop videos long enough
	   (WCAG 2.2.2, >5s) to need a way to stop the motion */
	.case__video-toggle {
		position: absolute;
		bottom: 16px;
		right: 16px;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		border: none;
		background: rgb(255 255 255 / 15%);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		cursor: pointer;
	}

	.case__video-toggle-icon {
		position: relative;
		display: block;
		width: 12px;
		height: 12px;
	}

	/* pause glyph (two bars): shown while the video is playing */
	.case__video-toggle-icon::before,
	.case__video-toggle-icon::after {
		content: '';
		position: absolute;
		top: 0;
		width: 3px;
		height: 12px;
		background: var(--white);
	}

	.case__video-toggle-icon::before {
		left: 1px;
	}

	.case__video-toggle-icon::after {
		right: 1px;
	}

	/* play glyph (triangle): shown once paused */
	.case__video-toggle[data-state='paused'] .case__video-toggle-icon::before {
		top: -1px;
		left: 0;
		width: 0;
		height: 0;
		background: transparent;
		border-style: solid;
		border-width: 7px 0 7px 12px;
		border-color: transparent transparent transparent var(--white);
	}

	.case__video-toggle[data-state='paused'] .case__video-toggle-icon::after {
		content: none;
	}

	.case__placeholder {
		height: 380px;
		border-radius: 20px;
		background: #ececec;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 13px;
		color: var(--gray);
	}

	.case__placeholder--image {
		height: auto;
		aspect-ratio: 16 / 10;
		overflow: hidden;
	}

	.case__placeholder--image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
		border-radius: 20px;
	}

	/* for screenshots whose aspect ratio doesn't suit a landscape cover-crop
	   (e.g. portrait phone UI, or a wide dashboard screenshot): a cover-crop
	   would cut content off, so show the whole image, letterboxed on the
	   project's brand color, instead */
	.case__placeholder--contain {
		height: 480px;
		aspect-ratio: auto;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.case__placeholder--contain img {
		max-width: 90%;
		max-height: 90%;
		width: auto;
		height: auto;
		object-fit: contain;
		object-position: center;
	}

	.case__placeholder--wide {
		height: 340px;
		margin-top: 32px;
	}

	.case__gallery--wide {
		grid-template-columns: 1fr 1fr;
	}

	.case__placeholder--wide-image {
		height: auto;
		aspect-ratio: 16 / 10;
		overflow: hidden;
	}

	.case__placeholder--wide-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
		border-radius: 20px;
	}

	.case__footer {
		border-top: 1px solid var(--border);
		padding-top: 40px;
		display: flex;
		justify-content: space-between;
		gap: 24px;
		flex-wrap: wrap;
	}

	.case__nav-link {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.case__nav-link--next {
		text-align: right;
		align-items: flex-end;
	}

	.case__nav-name {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: clamp(28px, 4vw, 34px);
	}

	@media (max-width: 720px) {
		.case__meta {
			grid-template-columns: repeat(2, 1fr);
		}
		.case__gallery {
			grid-template-columns: 1fr;
		}

		.case__footer {
			flex-direction: column;
		}

		.case__nav-link--next {
			text-align: left;
			align-items: flex-start;
		}

		/* drop the colored frame around the cover screenshot on mobile —
		   it eats into space the image could use on a small screen */
		.case__cover--image {
			background: transparent;
			height: auto;
			border-radius: 0;
		}

		.case__cover--image img {
			width: 100%;
			height: auto;
			border-radius: 0;
		}

		/* same problem as the cover above, but for letterboxed gallery images:
		   a fixed 480px box makes a wide screenshot render tiny with a huge
		   colored frame around it on a narrow screen — let the image set its
		   own height at full width instead */
		.case__placeholder--contain {
			height: auto;
		}

		.case__placeholder--contain img {
			max-width: 100%;
			max-height: none;
			width: 100%;
			height: auto;
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLButtonElement>('.case__video-toggle').forEach((button) => {
		const video = button.previousElementSibling;
		if (!(video instanceof HTMLVideoElement)) return;

		button.addEventListener('click', () => {
			if (video.paused) {
				video.play();
				button.dataset.state = 'playing';
				button.setAttribute('aria-label', 'Pause video');
			} else {
				video.pause();
				button.dataset.state = 'paused';
				button.setAttribute('aria-label', 'Play video');
			}
		});
	});
</script>
