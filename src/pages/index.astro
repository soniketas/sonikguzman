---
import Layout from '../layouts/Layout.astro';
import HomeGrid from '../components/HomeGrid.astro';
import { projects } from '../data/projects';
---

<Layout title="Sonia · Design + Development" bodyClass="home-page">
	<main id="main-content">
		<HomeGrid projects={projects} />
	</main>
</Layout>

<style is:global>
	/* No-scroll single-screen only applies where the grid's hover/wheel/tab
	   interaction model actually works (see the matching min-width check in
	   HomeGrid.astro's script). Below that, the grid stacks into one column
	   and needs normal page scroll to reach every card. */
	@media (min-width: 901px) {
		html:has(body.home-page) {
			height: 100%;
			overflow: hidden;
		}
		body.home-page {
			height: 100%;
			overflow: hidden;
		}
	}
</style>
