---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import IntroWordmark from '../components/IntroWordmark.astro';
import ProjectStack from '../components/ProjectStack.astro';
import Footer from '../components/Footer.astro';
import { projects } from '../data/projects';
---

<Layout title="Sonia · Design + Development">
	<Nav />
	<main id="main-content">
		<IntroWordmark
			name="sonik"
			bio="Independent UX/UI designer and developer who builds with a lighter footprint and designs for everyone, following WCAG accessibility guidelines. I collaborate with studios and brands on projects spanning branding to full digital products."
		/>
		<ProjectStack projects={projects} />
		<Footer />
	</main>
</Layout>
